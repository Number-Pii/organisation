{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$$CLAUDE_PROJECT_DIR/.claude/hooks/protect_main.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$$CLAUDE_PROJECT_DIR/.claude/hooks/context-checklist.md\""
          }
        ]
      }
    ]
  }
}
